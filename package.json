    "angular-eslint": "^22.2.0",
    "eslint": "^10.9.1",
    "eslint-plugin-only-warn": "^1.2.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "jsonc-parser": "^3.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
